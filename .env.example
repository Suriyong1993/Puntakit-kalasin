# Runtime configuration for a Supabase-backed deployment.
# Never commit real values to Git.
DATABASE_URL=postgresql://...
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com

# Browser-safe public values. Row Level Security in the included migration
# protects all business data. Do not add a service-role key to any VITE_ value.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Existing Manus storage integration (optional for local preview)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
